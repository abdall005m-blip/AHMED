<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nexus" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Nexus.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_notification</item>
        <item name="postSplashScreenTheme">@style/Theme.Nexus</item>
    </style>
</resources>
